{
	"$schema": "https://schemas.wp.org/wp/6.7/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{
					"color": "#F5F5F5",
					"name": "Base",
					"slug": "base"
				},
				{
					"color": "#FFFFFF",
					"name": "Base White",
					"slug": "base-white"
				},
				{
					"color": "#111111",
					"name": "Contrast",
					"slug": "contrast"
				},
				{
					"color": "#E10600",
					"name": "Primary (Brand Red)",
					"slug": "primary"
				},
				{
					"color": "#B00400",
					"name": "Primary Dark",
					"slug": "primary-dark"
				},
				{
					"color": "#6B6B6B",
					"name": "Muted",
					"slug": "muted"
				},
				{
					"color": "#1A1A1A",
					"name": "Footer Dark",
					"slug": "footer-dark"
				}
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1280px"
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"fontFamily": "\"Geist\", system-ui, -apple-system, \"Segoe UI\", sans-serif",
					"name": "Geist",
					"slug": "geist",
					"fontFace": [
						{
							"fontFamily": "Geist",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist/Geist-Regular.woff2" ]
						},
						{
							"fontFamily": "Geist",
							"fontWeight": "500",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist/Geist-Medium.woff2" ]
						},
						{
							"fontFamily": "Geist",
							"fontWeight": "600",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist/Geist-SemiBold.woff2" ]
						},
						{
							"fontFamily": "Geist",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/geist/Geist-Bold.woff2" ]
						}
					]
				}
			],
			"fontSizes": [
				{
					"fluid": {
						"min": "0.875rem",
						"max": "1rem"
					},
					"name": "Small",
					"size": "1rem",
					"slug": "small"
				},
				{
					"fluid": {
						"min": "1rem",
						"max": "1.125rem"
					},
					"name": "Medium",
					"size": "1.125rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"min": "1.25rem",
						"max": "1.5rem"
					},
					"name": "Large",
					"size": "1.5rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.875rem",
						"max": "2.875rem"
					},
					"name": "Extra Large",
					"size": "2.875rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "1.875rem",
						"max": "3.75rem"
					},
					"name": "XX Large",
					"size": "3.75rem",
					"slug": "xx-large"
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Tiny", "size": "8px", "slug": "20" },
				{ "name": "X-Small", "size": "16px", "slug": "30" },
				{ "name": "Small", "size": "24px", "slug": "40" },
				{ "name": "Regular", "size": "clamp(24px, 4vw, 40px)", "slug": "50" },
				{ "name": "Large", "size": "clamp(40px, 6vw, 72px)", "slug": "60" },
				{ "name": "X-Large", "size": "clamp(56px, 8vw, 96px)", "slug": "70" }
			]
		},
		"useRootPaddingAwareAlignments": true
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--geist)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.5"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--geist)",
					"fontWeight": "400",
					"lineHeight": "1.1"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"letterSpacing": "-0.02em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)",
					"letterSpacing": "-0.02em"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base-white)"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--geist)",
					"fontWeight": "500",
					"fontSize": "var(--wp--preset--font-size--small)"
				},
				"border": {
					"radius": "999px"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--contrast)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--geist)",
					"fontWeight": "600"
				}
			},
			"core/navigation": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--geist)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"fontWeight": "500"
				}
			}
		}
	}
}
